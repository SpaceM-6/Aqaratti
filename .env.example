# انسخ هذا الملف إلى .env في جذر المشروع (D:\Aqaratti\.env) ثم املأ القيم الحقيقية.
# .env مُستثنى مسبقاً في .gitignore ولن يُرفع على Git أبداً - لا تغيّر هذا.

# رابط مشروع Supabase (Project Settings > API > Project URL)
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co

# المفتاح العام anon (Project Settings > API > anon public).
# آمن للاستخدام داخل المتصفح لأن جدول brokers محمي بـ RLS للقراءة فقط (راجع supabase/schema.sql).
# هذا المشروع يستخدمه بالفعل بشكل مباشر في www/supabase-client.js.
SUPABASE_ANON_KEY=your-anon-key-here

# المفتاح السرّي service_role (Project Settings > API > service_role secret).
# يتجاوز RLS بالكامل - يُستخدم فقط من scripts/import-to-supabase.py محلياً على جهازك.
# لا تضعه أبداً في أي ملف JS يعمل داخل المتصفح، ولا ترفعه لأي مكان عام.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
